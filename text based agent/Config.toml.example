# Configuration Template for Voice Agent
# Copy this file to Config.toml and fill in your values

# OpenAI API Key (required)
# Get your API key from: https://platform.openai.com/api-keys
openaiToken = "sk-your-openai-api-key-here"

# WebSocket Server Port (optional, default: 8001)
# Change this if port 8001 is already in use
websocketPort = 8001
